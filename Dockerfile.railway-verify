# PRIVATE, disposable, NON-PRODUCTION CI equivalent on Railway.
# The image can only build when EVERY explicitly checked step succeeds.
# This is a PARTIAL Level A gate; SQL/RLS, MFA, Playwright and Level C
# remain unverified until independently executed on clean Supabase.
FROM node:22.16.0-bookworm AS verify
WORKDIR /src
ENV CI=true
RUN mkdir /gate
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund && echo 'dependencies PASS' >> /gate/verified.txt
COPY . .
RUN node scripts/ci/check-github-actions-pinning.mjs && echo 'supply_chain PASS' >> /gate/verified.txt
RUN node scripts/ci/check-visual-fidelity-contract.mjs && echo 'visual_source PASS' >> /gate/verified.txt
RUN node --test tests/integration-runtime.test.mjs tests/onboarding-foundation.test.mjs tests/attendance.test.mjs tests/mfa-foundation.test.mjs && echo 'unit_tests PASS' >> /gate/verified.txt
RUN npm audit --audit-level=high && echo 'dependency_audit PASS' >> /gate/verified.txt
RUN npm run build && echo 'production_build PASS' >> /gate/verified.txt
RUN sha256sum package-lock.json > /gate/package-lock.sha256 && \
    printf '%s\n' 'database_replay NOT_VERIFIED' 'sql_rls NOT_VERIFIED' 'account_mfa NOT_VERIFIED' 'browser_shards NOT_VERIFIED' 'visual_level_c NOT_VERIFIED' 'independent_review NOT_VERIFIED' > /gate/outstanding.txt && \
    test "$(wc -l < /gate/verified.txt)" -eq 6

# The runtime contains evidence only, NEVER source, database keys or app server.
FROM node:22.16.0-bookworm-slim
WORKDIR /gate
COPY --from=verify /gate/verified.txt /gate/verified.txt
COPY --from=verify /gate/outstanding.txt /gate/outstanding.txt
COPY --from=verify /gate/package-lock.sha256 /gate/package-lock.sha256
CMD ["sh","-c","echo CEAC_PRIVATE_VERIFY_ARTIFACT_BEGIN; cat /gate/verified.txt /gate/outstanding.txt /gate/package-lock.sha256; echo CEAC_PRIVATE_VERIFY_ARTIFACT_END; sleep 15"]
