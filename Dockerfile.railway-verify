# Standalone, private, NON-PRODUCTION CEAC verification build.
# No live Supabase URL, database secret, service role key, domain or application instance.
# This is a partial gate: SQL replay, MFA, browser shards, visual owner acceptance
# and second reviewer remain mandatory on a disposable dedicated runner.
FROM node:22.16.0-bookworm AS verify
WORKDIR /src
ENV CI=true
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN node scripts/ci/check-github-actions-pinning.mjs
RUN node scripts/ci/check-visual-fidelity-contract.mjs
RUN node --test tests/integration-runtime.test.mjs tests/onboarding-foundation.test.mjs tests/attendance.test.mjs tests/mfa-foundation.test.mjs
RUN npm audit --audit-level=high
RUN npm run build
# Make runtime exit intentionally; never serve sensitive customer application
# without verified security gates or production authorization.
FROM node:22.16.0-bookworm-slim
CMD ["node", "-e", "console.log('CEAC PARTIAL verification image built successfully. Database, browser, MFA, visual and production gates NOT VERIFIED.')"]
