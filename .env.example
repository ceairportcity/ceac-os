# Preferred for production/staging so each environment can point at its own Supabase project.
# If omitted, CEAC OS falls back to the current production project's public URL and publishable client key.
# The fallback is intentionally publishable browser configuration only; no service-role or private key is embedded.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# CEAC-only browser key, restricted to authorised CEAC origins + Maps JavaScript API.
# Configure billing/quota with the owner before enabling production map requests.
VITE_GOOGLE_MAPS_API_KEY=
